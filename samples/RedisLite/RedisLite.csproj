<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Every public member must carry XML docs: a missing or broken doc comment fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>A small, resilient Redis client: RESP2, pipelining, retries, TLS, Unix sockets and pub/sub as IAsyncEnumerable.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RedisLite.Tests" />
  </ItemGroup>

</Project>
